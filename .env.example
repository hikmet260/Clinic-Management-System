# Postgres (used by docker-compose.yml)
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=clinic_password
POSTGRES_DB=clinic_db
POSTGRES_PORT=5432

# Server
DATABASE_URL=postgres://clinic_user:clinic_password@localhost:5432/clinic_db
JWT_SECRET=super-secret-key-change-in-prod
PORT=3000
CORS_ORIGIN=http://localhost:5173
